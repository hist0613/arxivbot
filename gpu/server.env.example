# GPU 서버의 작업 폴더에 server.env 로 복사해 값을 채운다. 이 파일만 저장소에 있고 server.env 는 올리지 않는다.

# 요약·추출을 돌릴 파이썬 (beautifulsoup4 requests openai pillow resvg-py)
PY=/path/to/venv/bin/python
# vLLM 이 깔린 파이썬. 모델에 맞는 transformers 버전이 깔린 쪽을 고른다
VLLM_PY=/path/to/vllm-env/bin/python
# vLLM JIT 에 필요한 ninja 가 VLLM_PY 옆에 없으면 그 폴더를 적는다
EXTRA_PATH=
CUDA_HOME=/usr/local/cuda

MODEL_ID=RedHatAI/gemma-4-26B-A4B-it-FP8-dynamic
SERVED=gemma-4-26b-a4b-fp8
REASONING_PARSER=gemma4
PROMPT=v2
TP=2

# slurm
PARTITION=gpu
JOB_TIME=4:00:00
NICE=0
# 받으면 안 되는 카드 번호(쉼표로). 비워 두면 검사하지 않는다
AVOID_GPUS=
# 모델이 기본 HF 캐시 밖(공용 캐시 등)에 있으면 콜론으로 이어 적는다
HF_EXTRA_CACHES=
